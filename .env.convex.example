# Set these on the Convex deployment with `bunx convex env set`.
# Do not expose them through VITE_ variables or copy them into a frontend build.
# Convex provides server-side CONVEX_SITE_URL automatically.
SITE_URL=https://discovery.example.com
BETTER_AUTH_SECRET=
# Separate high-entropy secret used to encrypt recoverable Interview Links.
CAPABILITY_ENCRYPTION_SECRET=
# Comma-separated verified Creator email addresses permitted to register.
CREATOR_ALLOWLIST=creator@example.com
# Configure at least one complete OAuth credential pair.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPENROUTER_API_KEY=
# Full Cloudflare Email Service REST endpoint for the sending account.
CLOUDFLARE_EMAIL_API_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/email/sending/send
CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM=notifications@example.com
EMAIL_FROM_NAME=drefrajo | Interview

# Stripe Managed Payments. Configure these only on the server-side Convex
# deployment; never expose them as VITE_ variables or commit real values.
# Use STRIPE_MODE=sandbox with sk_test_... and sandbox Price IDs in development.
# Use STRIPE_MODE=live with sk_live_... and separately approved live Price IDs
# only after the owner approves the go-live setup.
STRIPE_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_ONE_PASS_PRICE_ID=
STRIPE_FIVE_PASS_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=https://discovery.example.com/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://discovery.example.com/billing/cancel
