# Set these on the Convex deployment with `bunx convex env set`.
# Do not expose them through VITE_ variables or copy them into a frontend build.
CONVEX_SITE_URL=https://your-deployment.convex.site
SITE_URL=https://discovery.example.com
BETTER_AUTH_SECRET=
# Configure at least one complete OAuth credential pair. The other provider
# can be added later without changing application code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
