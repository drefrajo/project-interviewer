# Set these on the Convex deployment with `bunx convex env set`.
# Do not expose them through VITE_ variables or copy them into a frontend build.
# Convex provides server-side CONVEX_SITE_URL automatically.
SITE_URL=https://discovery.example.com
BETTER_AUTH_SECRET=
# Separate high-entropy secret used to encrypt recoverable Interview Links.
CAPABILITY_ENCRYPTION_SECRET=
# Comma-separated verified Creator email addresses permitted to register.
CREATOR_ALLOWLIST=creator@example.com
# Configure at least one complete OAuth credential pair.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPENROUTER_API_KEY=
# Full Cloudflare Email Service REST endpoint for the sending account.
CLOUDFLARE_EMAIL_API_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/email/sending/send
CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM=notifications@example.com
