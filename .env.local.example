# Vite local mode, backed by the Convex development deployment.
VITE_CONVEX_URL=https://your-development-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-development-deployment.convex.site

# Configure the matching Convex deployment from `.env.convex.example` and use
# SITE_URL=http://localhost:5173 there. Never expose server secrets as VITE_*.
