{
  "name": "project-interviewer",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode local-development",
    "dev:development": "vite --mode development",
    "convex:dev": "bun scripts/convex-dev.ts",
    "convex:codegen": "bunx convex codegen",
    "build": "tsc -b && vite build",
    "build:development": "vite build --mode development",
    "build:production": "bun run validate:production && vite build --mode production && bun run validate:production-build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "verify": "bun run test && bun run typecheck && bun run lint && bun run build:production",
    "validate:production": "bun scripts/validate-production.ts",
    "validate:production-build": "bun scripts/validate-production-build.ts",
    "validate:deploy-machine": "bun scripts/validate-deploy-machine.ts",
    "validate:convex-deploy": "bun scripts/validate-convex-deploy.ts",
    "deploy:convex": "bun run validate:convex-deploy && bunx convex deploy",
    "deploy:convex:ci": "bun run validate:deploy-machine && bunx convex deploy",
    "deploy:cloudflare": "bun run build:production && bunx wrangler deploy --env production --var OAUTH_PROXY_CONVEX_SITE_URL:$VITE_CONVEX_SITE_URL",
    "deploy:cloudflare:development": "bun run build:production && bunx wrangler deploy --env development"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.0",
    "@convex-dev/agent": "^0.6.4",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "ai": "^6.0.35",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.41.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.34.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "convex-test": "^0.0.54",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.112.0"
  }
}
