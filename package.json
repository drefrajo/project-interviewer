{
  "name": "project-interviewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode local-development",
    "dev:development": "vite --mode development",
    "convex:dev": "bunx convex dev",
    "convex:codegen": "bunx convex codegen",
    "build": "tsc -b && vite build",
    "build:development": "vite build --mode development",
    "build:production": "bun run validate:production && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "verify": "bun run test && bun run evaluate && bun run typecheck && bun run lint && bun run build",
    "verify:runtime": "bun run verify:accessibility",
    "runtime:capture-session": "bun scripts/capture-runtime-session.ts",
    "evaluate": "bun scripts/evaluate.ts",
    "verify:accessibility": "bun scripts/verify-accessibility.ts",
    "validate:production": "bun scripts/validate-production.ts",
    "validate:convex-deploy": "bun scripts/validate-convex-deploy.ts",
    "deploy:convex": "bun run validate:convex-deploy && bunx convex deploy",
    "deploy:cloudflare": "bun run build:production && bunx wrangler deploy"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.23",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/workflow": "^0.4.4",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.27.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.112.0"
  }
}
